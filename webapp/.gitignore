# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local Playwright credentials (copy the tracked example, never commit values)
.env.e2e
.env.e2e.local

# Capacitor iOS — track the native project but not generated/build artifacts
ios/App/App/public/
ios/App/Pods/
ios/DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env. VITE_* vars are publishable and ship in the bundle, but the file
# itself stays untracked so a future server-side secret cannot leak via it.
.env
.env.local

# Supabase CLI scratch state (project ref, pooler URL, tool versions)
.temp/
supabase/.temp/
