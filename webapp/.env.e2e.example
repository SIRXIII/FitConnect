# Copy this file to .env.e2e and populate it with disposable test accounts.
# .env.e2e is ignored by git. Never commit real credentials.

FITRUSH_E2E_ADMIN_EMAIL=
FITRUSH_E2E_ADMIN_PASSWORD=

FITRUSH_E2E_TRAINER_EMAIL=
FITRUSH_E2E_TRAINER_PASSWORD=

FITRUSH_E2E_CLIENT_EMAIL=
FITRUSH_E2E_CLIENT_PASSWORD=
